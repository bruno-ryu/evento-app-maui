<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventoApp.Views.ListaEventosPage"
             Title="Eventos Cadastrados"
             BackgroundColor="{StaticResource Fundo}">

    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="12" MaximumWidthRequest="600">

        <CollectionView x:Name="EventosView"
                        Grid.Row="0"
                        SelectionMode="Single"
                        SelectionChanged="OnEventoSelecionado">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                    <Label Text="Nenhum evento cadastrado ainda."
                           HorizontalTextAlignment="Center"
                           FontSize="16" />
                    <Label Text="Toque em &quot;Novo evento&quot; para começar."
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextoSuave}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Nome}"
                                   FontSize="17"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding PeriodoTexto}"
                                   TextColor="{StaticResource TextoSuave}" />
                            <Label Text="{Binding Local}"
                                   TextColor="{StaticResource TextoSuave}" />
                            <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primaria}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="Novo evento"
                BackgroundColor="{StaticResource Primaria}"
                TextColor="White"
                Clicked="OnNovoEventoClicked" />
    </Grid>
</ContentPage>
